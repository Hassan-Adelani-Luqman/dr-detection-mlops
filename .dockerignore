# Version control / IDE
.git/
.gitignore
.dockerignore

# Python
**/__pycache__
**/*.pyc
.venv/
.env
*.log

# Not needed in the image (keeps build context small)
tests/
notebook/
*.md
scripts/
pytest.ini

# APTOS images used for local demos (not redistributable)
demo_images/

# Runtime data — mounted via volumes, not baked in
data/uploads/*
data/app.db
data/raw
data/train/*
data/test/*
backup/
requirements-dev.txt
models/exp5_current.keras
models/exp5_staging.keras
models/versions/*.keras
models/model_registry.json

# Root-level source duplicates
/exp5_deep_cnn.keras
/diabetic_retinopathy_detection.ipynb
