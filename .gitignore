# Python
__pycache__/
*.pyc
.venv/
.env
*.log

# Root-level source artifacts (copied into models/ and notebook/; do not double-commit)
/exp5_deep_cnn.keras
/diabetic_retinopathy_detection.ipynb

# Runtime-generated data
data/uploads/*
!data/uploads/.gitkeep
data/app.db

# Replay buffer and held-out evaluation images (APTOS, not redistributable).
# Keep the folder READMEs, .gitkeep and the evaluation manifest.
data/train/*
!data/train/.gitkeep
!data/train/README.md
data/test/*
!data/test/.gitkeep
!data/test/README.md
!data/test/manifest.csv

# Local APTOS dataset: a symlink to the original project's data/raw.
# No trailing slash, so the pattern matches the symlink itself. Never committed.
data/raw

# Local backups of runtime state (registry, models, database, uploads)
backup/

# Runtime-generated models (regenerated from exp5_base.keras at startup)
models/exp5_current.keras
models/exp5_staging.keras
models/versions/*.keras
models/model_registry.json

# Test data (APTOS images not redistributable — see README)
tests/sample_images/*
!tests/sample_images/.gitkeep

# Local demo images (APTOS — not redistributable)
demo_images/

# NOTE: models/exp5_base.keras IS committed (needed for deployment).

# Load testing: images are APTOS (not redistributable); keep the summarised
# results, drop Locust's bulky per-second history and raw logs.
loadtest/images/
loadtest/results/**/*_stats_history.csv
loadtest/results/**/*_exceptions.csv
loadtest/results/**/*.log
loadtest/results/**/*.html
